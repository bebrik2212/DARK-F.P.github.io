const PANTRY_ID = 'dark-fort-social-2026';

async function loadFromCloud() {
    const response = await fetch(`https://getpantry.cloud/apiv1/pantry/${PANTRY_ID}/basket/social-data`);
    if (response.status === 404) {
        return { posts: [], profiles: {}, notifications: [] };
    }
    return response.json();
}

async function saveToCloud(data) {
    await fetch(`https://getpantry.cloud/apiv1/pantry/${PANTRY_ID}/basket/social-data`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });
}
